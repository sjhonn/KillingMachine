@{
    ViewData["Title"] = "Calculadora IMC";
}
<section class="page-header">
    <div class="container">
        <span class="eyebrow">HERRAMIENTA PUBLICA</span>
        <h1>Calculadora de IMC</h1>
        <p>Calculo orientativo del indice de masa corporal.</p>
    </div>
</section>
<section class="section compact">
    <div class="container narrow">
        <form class="panel-form" id="imcForm">
            <div class="form-grid two">
                <div class="form-group"><label for="weight">Peso (kg)</label><input id="weight" type="number" min="20" max="500" step="0.1" required /></div>
                <div class="form-group"><label for="height">Altura (cm)</label><input id="height" type="number" min="80" max="250" step="0.1" required /></div>
            </div>
            <button class="btn btn-primary" type="submit">Calcular IMC</button>
        </form>
        <div class="imc-result" id="imcResult" aria-live="polite">Ingrese sus datos para calcular.</div>
        <p class="legal-note">El resultado es referencial y no reemplaza una evaluacion medica o nutricional.</p>
    </div>
</section>
@section Scripts {
<script>
    document.getElementById('imcForm').addEventListener('submit', function (event) {
        event.preventDefault();
        const weight = Number(document.getElementById('weight').value);
        const heightM = Number(document.getElementById('height').value) / 100;
        const bmi = weight / (heightM * heightM);
        let category = 'Obesidad';
        if (bmi < 18.5) category = 'Bajo peso';
        else if (bmi < 25) category = 'Rango normal';
        else if (bmi < 30) category = 'Sobrepeso';
        document.getElementById('imcResult').textContent = `IMC: ${bmi.toFixed(2)} - ${category}`;
    });
</script>
}
