@model BodyMeasurement
@{ ViewData["Title"] = "Registrar medicion"; }<section class="page-header"><div class="container"><h1>Registrar medicion</h1></div></section><section class="crud-shell"><div class="container narrow"><form asp-action="Create" method="post" class="panel-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>        <div class="form-grid two">
            <div class="form-group"><label asp-for="ClientId"></label><select asp-for="ClientId" asp-items="ViewBag.ClientId" required><option value="">Seleccione</option></select><span asp-validation-for="ClientId"></span></div>
            <div class="form-group"><label asp-for="MeasurementDate"></label><input asp-for="MeasurementDate" type="date" required /><span asp-validation-for="MeasurementDate"></span></div>
            <div class="form-group"><label asp-for="WeightKg"></label><input asp-for="WeightKg" type="number" step="0.1" required /><span asp-validation-for="WeightKg"></span></div>
            <div class="form-group"><label asp-for="WaistCm"></label><input asp-for="WaistCm" type="number" step="0.1" required /><span asp-validation-for="WaistCm"></span></div>
            <div class="form-group"><label asp-for="ChestCm"></label><input asp-for="ChestCm" type="number" step="0.1" required /><span asp-validation-for="ChestCm"></span></div>
            <div class="form-group"><label asp-for="ArmCm"></label><input asp-for="ArmCm" type="number" step="0.1" required /><span asp-validation-for="ArmCm"></span></div>
            <div class="form-group"><label asp-for="LegCm"></label><input asp-for="LegCm" type="number" step="0.1" required /><span asp-validation-for="LegCm"></span></div>
            <div class="form-group"><label asp-for="BodyFatPercentage"></label><input asp-for="BodyFatPercentage" type="number" step="0.1" required /><span asp-validation-for="BodyFatPercentage"></span></div>
        </div><div class="actions" style="margin-top:22px"><button class="btn btn-primary" type="submit">Guardar</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div></form></div></section>