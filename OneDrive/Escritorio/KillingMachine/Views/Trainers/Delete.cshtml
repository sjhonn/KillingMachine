@model Trainer
@{ ViewData["Title"] = "Eliminar registro"; }
<section class="page-header"><div class="container"><span class="eyebrow">ENTRENADORES</span><h1>Eliminar registro</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <div class="confirm-box"><strong>Confirme la eliminacion.</strong><p>Esta accion no se puede deshacer.</p></div>
    <dl class="details-grid">
        <div><dt>@Html.DisplayNameFor(model => model.FullName)</dt><dd>@Model.FullName</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Specialty)</dt><dd>@Model.Specialty</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Email)</dt><dd>@Model.Email</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Phone)</dt><dd>@Model.Phone</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Biography)</dt><dd>@Model.Biography</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Schedule)</dt><dd>@Model.Schedule</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.IsActive)</dt><dd>@(Model.IsActive ? "Si" : "No")</dd></div>
    </dl>
    <form asp-action="Delete" method="post" class="actions" style="margin-top:22px">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">Eliminar definitivamente</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div></section>
