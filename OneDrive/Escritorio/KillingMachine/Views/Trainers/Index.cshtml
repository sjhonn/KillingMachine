@model IEnumerable<Trainer>
@{ ViewData["Title"] = "Entrenadores"; }
<section class="page-header"><div class="container"><span class="eyebrow">CRUD PUBLICO</span><h1>Entrenadores</h1><p>Crear, consultar, editar y eliminar registros.</p></div></section>
<section class="crud-shell">
    <div class="container">
        <div class="crud-toolbar"><h2>Registros</h2><a class="btn btn-primary" asp-action="Create">Nuevo registro</a></div>
        @if (!Model.Any())
        {
            <div class="empty-state">No existen registros.</div>
        }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr>
                    <th>@Html.DisplayNameFor(model => model.FullName)</th>
                    <th>@Html.DisplayNameFor(model => model.Specialty)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Phone)</th>
                    <th>@Html.DisplayNameFor(model => model.Biography)</th>
                    <th>@Html.DisplayNameFor(model => model.Schedule)</th>
                    <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                    <th>Acciones</th>
                </tr></thead><tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Specialty</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Biography</td>
                    <td>@item.Schedule</td>
                    <td>@(item.IsActive ? "Si" : "No")</td>
                    <td><div class="actions"><a class="btn btn-small btn-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></div></td>
                </tr>
            }
            </tbody></table></div>
        }
    </div>
</section>
