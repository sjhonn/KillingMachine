<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Killing Machine - gimnasio, entrenamiento y control de progreso." />
    <title>@ViewData["Title"] - Killing Machine</title>
    <link rel="icon" type="image/png" href="~/images/killing-machine-logo.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/killing-machine-logo.png" alt="Logo Killing Machine" />
            <span>KILLING MACHINE</span>
        </a>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-toggle>MENU</button>
        <nav class="main-nav" data-main-nav>
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a href="/#servicios">Servicios</a>
            <a href="/#planes">Planes</a>
            <a href="/#entrenadores">Entrenadores</a>
            <a asp-controller="Dashboard" asp-action="Index">Progreso</a>
            <a asp-controller="Tools" asp-action="Imc">IMC</a>
            <details class="nav-dropdown">
                <summary>Gestion publica</summary>
                <div class="dropdown-panel">
                    <a asp-controller="Clients" asp-action="Index">Clientes</a>
                    <a asp-controller="ClientMemberships" asp-action="Index">Membresias</a>
                    <a asp-controller="Trainers" asp-action="Index">Entrenadores</a>
                    <a asp-controller="Services" asp-action="Index">Servicios</a>
                    <a asp-controller="MembershipPlans" asp-action="Index">Planes comerciales</a>
                    <a asp-controller="Exercises" asp-action="Index">Ejercicios</a>
                    <a asp-controller="WorkoutPlans" asp-action="Index">Planes de entrenamiento</a>
                    <a asp-controller="WorkoutLogs" asp-action="Index">Entrenamientos</a>
                    <a asp-controller="BodyMeasurements" asp-action="Index">Peso y medidas</a>
                    <a asp-controller="WeeklySchedules" asp-action="Index">Calendario semanal</a>
                    <a asp-controller="GalleryItems" asp-action="Index">Galeria</a>
                    <a asp-controller="ContactMessages" asp-action="Index">Mensajes</a>
                    <a asp-controller="TrialRequests" asp-action="Index">Clases de prueba</a>
                </div>
            </details>
        </nav>
    </div>
</header>

<main>
    @if (TempData["Success"] is string success)
    {
        <div class="container flash flash-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="container flash flash-error">@error</div>
    }
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container footer-grid">
        <div>
            <strong>KILLING MACHINE</strong>
            <p>Entrenamiento para todos los niveles. Gestion publica de demostracion con ASP.NET Core y SQLite.</p>
        </div>
        <div>
            <strong>Horario</strong>
            <p>Lunes a viernes: 06:00 a 22:00<br />Sabados: 07:00 a 18:00</p>
        </div>
        <div>
            <strong>Contacto</strong>
            <p>Telefono: +51 999 999 999<br />Correo: contacto@killingmachine.local</p>
        </div>
    </div>
    <div class="container footer-bottom">&copy; @DateTime.Now.Year Killing Machine. Proyecto educativo.</div>
</footer>

<a class="whatsapp-button" href="https://wa.me/51999999999?text=Hola%20Killing%20Machine%2C%20deseo%20informacion" target="_blank" rel="noopener" aria-label="Contactar por WhatsApp">WhatsApp</a>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
