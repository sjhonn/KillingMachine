@model WeeklySchedule
@{ ViewData["Title"] = "Eliminar"; }<section class="page-header"><div class="container"><h1>Eliminar horario</h1></div></section><section class="crud-shell"><div class="container narrow"><div class="confirm-box"><strong>Confirme la eliminacion.</strong></div><dl class="details-grid"><div><dt>Cliente</dt><dd>@Model.Client?.FullName</dd></div><div><dt>Dia</dt><dd>@Model.DayOfWeek</dd></div><div><dt>Inicio</dt><dd>@Model.StartTime</dd></div><div><dt>Fin</dt><dd>@Model.EndTime</dd></div><div><dt>Actividad</dt><dd>@Model.Activity</dd></div><div><dt>Entrenador</dt><dd>@Model.Trainer?.FullName</dd></div><div><dt>Notas</dt><dd>@Model.Notes</dd></div></dl><form asp-action="Delete" method="post" class="actions" style="margin-top:22px"><input type="hidden" asp-for="Id" /><button class="btn btn-danger" type="submit">Eliminar</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></form></div></section>