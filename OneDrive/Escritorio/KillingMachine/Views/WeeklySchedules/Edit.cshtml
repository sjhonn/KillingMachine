@model WeeklySchedule
@{ ViewData["Title"] = "Editar horario"; }<section class="page-header"><div class="container"><h1>Editar horario</h1></div></section><section class="crud-shell"><div class="container narrow"><form asp-action="Edit" method="post" class="panel-form"><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid two">
<div class="form-group"><label asp-for="ClientId"></label><select asp-for="ClientId" asp-items="ViewBag.ClientId" required><option value="">Seleccione</option></select><span asp-validation-for="ClientId"></span></div>
<div class="form-group"><label asp-for="DayOfWeek"></label><select asp-for="DayOfWeek" required><option>Lunes</option><option>Martes</option><option>Miercoles</option><option>Jueves</option><option>Viernes</option><option>Sabado</option><option>Domingo</option></select><span asp-validation-for="DayOfWeek"></span></div>
<div class="form-group"><label asp-for="StartTime"></label><input asp-for="StartTime" type="time" required /><span asp-validation-for="StartTime"></span></div>
<div class="form-group"><label asp-for="EndTime"></label><input asp-for="EndTime" type="time" required /><span asp-validation-for="EndTime"></span></div>
<div class="form-group full"><label asp-for="Activity"></label><input asp-for="Activity" required /><span asp-validation-for="Activity"></span></div>
<div class="form-group"><label asp-for="TrainerId"></label><select asp-for="TrainerId" asp-items="ViewBag.TrainerId"><option value="">Sin asignar</option></select><span asp-validation-for="TrainerId"></span></div>
<div class="form-group full"><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4"></textarea><span asp-validation-for="Notes"></span></div>
</div><div class="actions" style="margin-top:22px"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div></form></div></section>