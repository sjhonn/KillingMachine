@model WeeklySchedule
@{ ViewData["Title"] = "Detalle"; }<section class="page-header"><div class="container"><h1>Detalle de horario</h1></div></section><section class="crud-shell"><div class="container narrow"><dl class="details-grid"><div><dt>Cliente</dt><dd>@Model.Client?.FullName</dd></div><div><dt>Dia</dt><dd>@Model.DayOfWeek</dd></div><div><dt>Inicio</dt><dd>@Model.StartTime</dd></div><div><dt>Fin</dt><dd>@Model.EndTime</dd></div><div><dt>Actividad</dt><dd>@Model.Activity</dd></div><div><dt>Entrenador</dt><dd>@Model.Trainer?.FullName</dd></div><div><dt>Notas</dt><dd>@Model.Notes</dd></div></dl><div class="actions" style="margin-top:22px"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-secondary" asp-action="Index">Volver</a></div></div></section>