@model Exercise
@{ ViewData["Title"] = "Eliminar registro"; }
<section class="page-header"><div class="container"><span class="eyebrow">EJERCICIOS</span><h1>Eliminar registro</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <div class="confirm-box"><strong>Confirme la eliminacion.</strong><p>Esta accion no se puede deshacer.</p></div>
    <dl class="details-grid">
        <div><dt>@Html.DisplayNameFor(model => model.Name)</dt><dd>@Model.Name</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.MuscleGroup)</dt><dd>@Model.MuscleGroup</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Description)</dt><dd>@Model.Description</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Equipment)</dt><dd>@Model.Equipment</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Difficulty)</dt><dd>@Model.Difficulty</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.CaloriesPerHour)</dt><dd>@Model.CaloriesPerHour</dd></div>
    </dl>
    <form asp-action="Delete" method="post" class="actions" style="margin-top:22px">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">Eliminar definitivamente</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div></section>
