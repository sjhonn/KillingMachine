@model Exercise
@{ ViewData["Title"] = "Editar registro"; }
<section class="page-header"><div class="container"><span class="eyebrow">EJERCICIOS</span><h1>Editar registro</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <form asp-action="Edit" method="post" class="panel-form">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid two">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" type="text" required />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="form-group">
                <label asp-for="MuscleGroup"></label>
                <input asp-for="MuscleGroup" type="text" required />
                <span asp-validation-for="MuscleGroup"></span>
            </div>
            <div class="form-group full">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="5" required></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="form-group">
                <label asp-for="Equipment"></label>
                <input asp-for="Equipment" type="text" />
                <span asp-validation-for="Equipment"></span>
            </div>
            <div class="form-group">
                <label asp-for="Difficulty"></label>
                <input asp-for="Difficulty" type="text" required />
                <span asp-validation-for="Difficulty"></span>
            </div>
            <div class="form-group">
                <label asp-for="CaloriesPerHour"></label>
                <input asp-for="CaloriesPerHour" type="number" step="1" required />
                <span asp-validation-for="CaloriesPerHour"></span>
            </div>
        </div>
        <div class="actions" style="margin-top:22px"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
    </form>
</div></section>
