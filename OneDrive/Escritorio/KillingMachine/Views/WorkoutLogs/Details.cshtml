@model WorkoutLog
@{ ViewData["Title"] = "Detalle"; }
<section class="page-header"><div class="container"><h1>Detalle del entrenamiento</h1></div></section><section class="crud-shell"><div class="container narrow">    <dl class="details-grid">
        <div><dt>Cliente</dt><dd>@Model.Client?.FullName</dd></div><div><dt>Ejercicio</dt><dd>@Model.Exercise?.Name</dd></div>
        <div><dt>Fecha</dt><dd>@Model.WorkoutDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Series</dt><dd>@Model.Sets</dd></div>
        <div><dt>Repeticiones</dt><dd>@Model.Repetitions</dd></div><div><dt>Peso usado</dt><dd>@Model.WeightKg.ToString("0.0") kg</dd></div>
        <div><dt>Duracion</dt><dd>@Model.DurationMinutes minutos</dd></div><div><dt>Notas</dt><dd>@Model.Notes</dd></div>
    </dl><div class="actions" style="margin-top:22px"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-secondary" asp-action="Index">Volver</a></div></div></section>
