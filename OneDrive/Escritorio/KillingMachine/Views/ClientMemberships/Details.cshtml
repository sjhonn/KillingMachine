@model ClientMembership
@{ ViewData["Title"] = "Detalle"; }<section class="page-header"><div class="container"><h1>Detalle de membresia</h1></div></section><section class="crud-shell"><div class="container narrow"><dl class="details-grid"><div><dt>Cliente</dt><dd>@Model.Client?.FullName</dd></div><div><dt>Plan</dt><dd>@Model.MembershipPlan?.Name</dd></div><div><dt>Fecha inicio</dt><dd>@Model.StartDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Fecha fin</dt><dd>@Model.EndDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Estado</dt><dd>@Model.Status</dd></div><div><dt>Monto pagado</dt><dd>S/ @Model.AmountPaid.ToString("0.00")</dd></div></dl><div class="actions" style="margin-top:22px"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-secondary" asp-action="Index">Volver</a></div></div></section>