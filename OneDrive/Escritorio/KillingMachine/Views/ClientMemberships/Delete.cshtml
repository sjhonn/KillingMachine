@model ClientMembership
@{ ViewData["Title"] = "Eliminar"; }<section class="page-header"><div class="container"><h1>Eliminar membresia</h1></div></section><section class="crud-shell"><div class="container narrow"><div class="confirm-box"><strong>Confirme la eliminacion.</strong></div><dl class="details-grid"><div><dt>Cliente</dt><dd>@Model.Client?.FullName</dd></div><div><dt>Plan</dt><dd>@Model.MembershipPlan?.Name</dd></div><div><dt>Fecha inicio</dt><dd>@Model.StartDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Fecha fin</dt><dd>@Model.EndDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Estado</dt><dd>@Model.Status</dd></div><div><dt>Monto pagado</dt><dd>S/ @Model.AmountPaid.ToString("0.00")</dd></div></dl><form asp-action="Delete" method="post" class="actions" style="margin-top:22px"><input type="hidden" asp-for="Id" /><button class="btn btn-danger" type="submit">Eliminar</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></form></div></section>