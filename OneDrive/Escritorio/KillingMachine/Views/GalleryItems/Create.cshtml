@model GalleryItem
@{ ViewData["Title"] = "Crear registro"; }
<section class="page-header"><div class="container"><span class="eyebrow">GALERIA</span><h1>Crear registro</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <form asp-action="Create" method="post" class="panel-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid two">
            <div class="form-group">
                <label asp-for="Title"></label>
                <input asp-for="Title" type="text" required />
                <span asp-validation-for="Title"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl"></label>
                <input asp-for="ImageUrl" type="text" required />
                <span asp-validation-for="ImageUrl"></span>
            </div>
            <div class="form-group full">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="5"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="form-group">
                <label asp-for="DisplayOrder"></label>
                <input asp-for="DisplayOrder" type="number" step="1" required />
                <span asp-validation-for="DisplayOrder"></span>
            </div>
            <div class="form-group full">
                <div class="form-check"><input asp-for="IsActive" /><label asp-for="IsActive"></label></div>
                <span asp-validation-for="IsActive"></span>
            </div>
        </div>
        <div class="actions" style="margin-top:22px"><button class="btn btn-primary" type="submit">Guardar</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
    </form>
</div></section>
