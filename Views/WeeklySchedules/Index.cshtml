@model IEnumerable<WeeklySchedule>
@{ ViewData["Title"] = "Calendario semanal"; }
<section class="page-header"><div class="container"><span class="eyebrow">AGENDA</span><h1>Calendario semanal</h1><p>Organiza actividades, horarios y entrenadores asignados.</p></div></section><section class="crud-shell"><div class="container"><div class="crud-toolbar"><h2>Horarios</h2><a class="btn btn-primary" asp-action="Create">Nuevo horario</a></div>
@if (!Model.Any()) { <div class="empty-state">No existen horarios.</div> } else { <div class="table-wrap"><table class="data-table"><thead><tr><th>Cliente</th><th>Dia</th><th>Inicio</th><th>Fin</th><th>Actividad</th><th>Entrenador</th><th>Acciones</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Client?.FullName</td><td>@item.DayOfWeek</td><td>@item.StartTime</td><td>@item.EndTime</td><td>@item.Activity</td><td>@item.Trainer?.FullName</td><td><div class="actions"><a class="btn btn-small btn-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></div></td></tr> }
</tbody></table></div> }</div></section>