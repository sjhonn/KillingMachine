@model MembershipPlan
@{ ViewData["Title"] = "Eliminar plan comercial"; }
<section class="page-header"><div class="container"><span class="eyebrow">PLANES COMERCIALES</span><h1>Eliminar plan comercial</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <div class="confirm-box"><strong>Confirma la eliminación.</strong><p>Esta acción no se puede deshacer.</p></div>
    <dl class="details-grid">
        <div><dt>@Html.DisplayNameFor(model => model.Name)</dt><dd>@Model.Name</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Description)</dt><dd>@Model.Description</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.MonthlyPrice)</dt><dd>@Model.MonthlyPrice.ToString("0.00")</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.DurationMonths)</dt><dd>@Model.DurationMonths</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Benefits)</dt><dd>@Model.Benefits</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.IsActive)</dt><dd>@(Model.IsActive ? "Si" : "No")</dd></div>
    </dl>
    <form asp-action="Delete" method="post" class="actions" style="margin-top:22px">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">Eliminar definitivamente</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div></section>
