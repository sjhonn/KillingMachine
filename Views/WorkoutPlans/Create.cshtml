@model WorkoutPlan
@{ ViewData["Title"] = "Registrar plan de entrenamiento"; }
<section class="page-header"><div class="container"><span class="eyebrow">PLANES DE ENTRENAMIENTO</span><h1>Registrar plan de entrenamiento</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <form asp-action="Create" method="post" class="panel-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid two">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" type="text" required />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="form-group">
                <label asp-for="Objective"></label>
                <input asp-for="Objective" type="text" required />
                <span asp-validation-for="Objective"></span>
            </div>
            <div class="form-group">
                <label asp-for="Level"></label>
                <input asp-for="Level" type="text" required />
                <span asp-validation-for="Level"></span>
            </div>
            <div class="form-group">
                <label asp-for="DurationWeeks"></label>
                <input asp-for="DurationWeeks" type="number" step="1" required />
                <span asp-validation-for="DurationWeeks"></span>
            </div>
            <div class="form-group">
                <label asp-for="SessionsPerWeek"></label>
                <input asp-for="SessionsPerWeek" type="number" step="1" required />
                <span asp-validation-for="SessionsPerWeek"></span>
            </div>
            <div class="form-group full">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="5" required></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="form-group full">
                <div class="form-check"><input asp-for="IsActive" /><label asp-for="IsActive"></label></div>
                <span asp-validation-for="IsActive"></span>
            </div>
        </div>
        <div class="actions" style="margin-top:22px"><button class="btn btn-primary" type="submit">Guardar</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
    </form>
</div></section>
