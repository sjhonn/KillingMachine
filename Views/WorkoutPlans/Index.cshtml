@model IEnumerable<WorkoutPlan>
@{ ViewData["Title"] = "Planes de entrenamiento"; }
<section class="page-header"><div class="container"><span class="eyebrow">PLANIFICACIÓN</span><h1>Planes de entrenamiento</h1><p>Organiza objetivos, niveles, duración y frecuencia semanal.</p></div></section>
<section class="crud-shell">
    <div class="container">
        <div class="crud-toolbar"><h2>Planes de entrenamiento</h2><a class="btn btn-primary" asp-action="Create">Nuevo plan de entrenamiento</a></div>
        @if (!Model.Any())
        {
            <div class="empty-state">No hay planes de entrenamiento registrados.</div>
        }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Objective)</th>
                    <th>@Html.DisplayNameFor(model => model.Level)</th>
                    <th>@Html.DisplayNameFor(model => model.DurationWeeks)</th>
                    <th>@Html.DisplayNameFor(model => model.SessionsPerWeek)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                    <th>Acciones</th>
                </tr></thead><tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Objective</td>
                    <td>@item.Level</td>
                    <td>@item.DurationWeeks</td>
                    <td>@item.SessionsPerWeek</td>
                    <td>@item.Description</td>
                    <td>@(item.IsActive ? "Si" : "No")</td>
                    <td><div class="actions"><a class="btn btn-small btn-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></div></td>
                </tr>
            }
            </tbody></table></div>
        }
    </div>
</section>
