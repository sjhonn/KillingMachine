@model IEnumerable<ContactMessage>
@{ ViewData["Title"] = "Mensajes de contacto"; }
<section class="page-header"><div class="container"><span class="eyebrow">ATENCIÓN</span><h1>Mensajes de contacto</h1><p>Revisa las consultas recibidas y actualiza su estado de atención.</p></div></section>
<section class="crud-shell">
    <div class="container">
        <div class="crud-toolbar"><h2>Mensajes recibidos</h2><a class="btn btn-primary" asp-action="Create">Nuevo mensaje</a></div>
        @if (!Model.Any())
        {
            <div class="empty-state">No hay mensajes registrados.</div>
        }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr>
                    <th>@Html.DisplayNameFor(model => model.FullName)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Phone)</th>
                    <th>@Html.DisplayNameFor(model => model.Subject)</th>
                    <th>@Html.DisplayNameFor(model => model.Message)</th>
                    <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th>Acciones</th>
                </tr></thead><tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Subject</td>
                    <td>@item.Message</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Status</td>
                    <td><div class="actions"><a class="btn btn-small btn-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></div></td>
                </tr>
            }
            </tbody></table></div>
        }
    </div>
</section>
