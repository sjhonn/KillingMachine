@model Client
@{ ViewData["Title"] = "Detalle de cliente"; }
<section class="page-header"><div class="container"><span class="eyebrow">CLIENTES</span><h1>Detalle de cliente</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <dl class="details-grid">
        <div><dt>@Html.DisplayNameFor(model => model.FullName)</dt><dd>@Model.FullName</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.DocumentNumber)</dt><dd>@Model.DocumentNumber</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Email)</dt><dd>@Model.Email</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Phone)</dt><dd>@Model.Phone</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.BirthDate)</dt><dd>@Model.BirthDate.ToString("dd/MM/yyyy")</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.HeightCm)</dt><dd>@Model.HeightCm.ToString("0.0")</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.JoinDate)</dt><dd>@Model.JoinDate.ToString("dd/MM/yyyy")</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.IsActive)</dt><dd>@(Model.IsActive ? "Si" : "No")</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Notes)</dt><dd>@Model.Notes</dd></div>
    </dl>
    <div class="actions" style="margin-top:22px"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-secondary" asp-action="Index">Volver</a></div>
</div></section>
