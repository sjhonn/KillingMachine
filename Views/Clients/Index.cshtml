@model IEnumerable<Client>
@{ ViewData["Title"] = "Clientes"; }
<section class="page-header"><div class="container"><span class="eyebrow">GESTIÓN DE CLIENTES</span><h1>Clientes</h1><p>Consulta y administra la información de las personas inscritas.</p></div></section>
<section class="crud-shell">
    <div class="container">
        <div class="crud-toolbar"><h2>Clientes registrados</h2><a class="btn btn-primary" asp-action="Create">Nuevo cliente</a></div>
        @if (!Model.Any())
        {
            <div class="empty-state">No hay clientes registrados.</div>
        }
        else
        {
            <div class="table-wrap"><table class="data-table"><thead><tr>
                    <th>@Html.DisplayNameFor(model => model.FullName)</th>
                    <th>@Html.DisplayNameFor(model => model.DocumentNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Phone)</th>
                    <th>@Html.DisplayNameFor(model => model.BirthDate)</th>
                    <th>@Html.DisplayNameFor(model => model.HeightCm)</th>
                    <th>@Html.DisplayNameFor(model => model.JoinDate)</th>
                    <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                    <th>@Html.DisplayNameFor(model => model.Notes)</th>
                    <th>Acciones</th>
                </tr></thead><tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.DocumentNumber</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.BirthDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.HeightCm.ToString("0.0")</td>
                    <td>@item.JoinDate.ToString("dd/MM/yyyy")</td>
                    <td>@(item.IsActive ? "Si" : "No")</td>
                    <td>@item.Notes</td>
                    <td><div class="actions"><a class="btn btn-small btn-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></div></td>
                </tr>
            }
            </tbody></table></div>
        }
    </div>
</section>
