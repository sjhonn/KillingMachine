@model TrialRequest
@{ ViewData["Title"] = "Eliminar solicitud"; }
<section class="page-header"><div class="container"><span class="eyebrow">SOLICITUDES DE CLASE</span><h1>Eliminar solicitud</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <div class="confirm-box"><strong>Confirma la eliminación.</strong><p>Esta acción no se puede deshacer.</p></div>
    <dl class="details-grid">
        <div><dt>@Html.DisplayNameFor(model => model.FullName)</dt><dd>@Model.FullName</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Email)</dt><dd>@Model.Email</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Phone)</dt><dd>@Model.Phone</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.PreferredDate)</dt><dd>@Model.PreferredDate.ToString("dd/MM/yyyy")</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.PreferredTime)</dt><dd>@Model.PreferredTime</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Objective)</dt><dd>@Model.Objective</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Status)</dt><dd>@Model.Status</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.CreatedAt)</dt><dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd></div>
    </dl>
    <form asp-action="Delete" method="post" class="actions" style="margin-top:22px">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">Eliminar definitivamente</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div></section>
