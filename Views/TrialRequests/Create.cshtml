@model TrialRequest
@{ ViewData["Title"] = "Registrar solicitud"; }
<section class="page-header"><div class="container"><span class="eyebrow">SOLICITUDES DE CLASE</span><h1>Registrar solicitud</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <form asp-action="Create" method="post" class="panel-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid two">
            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" type="text" required />
                <span asp-validation-for="FullName"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" required />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" type="tel" required />
                <span asp-validation-for="Phone"></span>
            </div>
            <div class="form-group">
                <label asp-for="PreferredDate"></label>
                <input asp-for="PreferredDate" type="date" asp-format="{0:yyyy-MM-dd}" required />
                <span asp-validation-for="PreferredDate"></span>
            </div>
            <div class="form-group">
                <label asp-for="PreferredTime"></label>
                <input asp-for="PreferredTime" type="time" required />
                <span asp-validation-for="PreferredTime"></span>
            </div>
            <div class="form-group full">
                <label asp-for="Objective"></label>
                <textarea asp-for="Objective" rows="5" required></textarea>
                <span asp-validation-for="Objective"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status"></label>
                <input asp-for="Status" type="text" required />
                <span asp-validation-for="Status"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedAt"></label>
                <input asp-for="CreatedAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required />
                <span asp-validation-for="CreatedAt"></span>
            </div>
        </div>
        <div class="actions" style="margin-top:22px"><button class="btn btn-primary" type="submit">Guardar</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
    </form>
</div></section>
