@model GalleryItem
@{ ViewData["Title"] = "Detalle de imagen"; }
<section class="page-header"><div class="container"><span class="eyebrow">GALERIA</span><h1>Detalle de imagen</h1></div></section>
<section class="crud-shell"><div class="container narrow">
    <dl class="details-grid">
        <div><dt>@Html.DisplayNameFor(model => model.Title)</dt><dd>@Model.Title</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.ImageUrl)</dt><dd>@Model.ImageUrl</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.Description)</dt><dd>@Model.Description</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.DisplayOrder)</dt><dd>@Model.DisplayOrder</dd></div>
        <div><dt>@Html.DisplayNameFor(model => model.IsActive)</dt><dd>@(Model.IsActive ? "Si" : "No")</dd></div>
    </dl>
    <div class="actions" style="margin-top:22px"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-secondary" asp-action="Index">Volver</a></div>
</div></section>
