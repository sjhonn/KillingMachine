@model BodyMeasurement
@{ ViewData["Title"] = "Detalle de medición corporal"; }<section class="page-header"><div class="container"><h1>Detalle de medicion</h1></div></section><section class="crud-shell"><div class="container narrow"><dl class="details-grid"><div><dt>Cliente</dt><dd>@Model.Client?.FullName</dd></div><div><dt>Fecha</dt><dd>@Model.MeasurementDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Peso</dt><dd>@Model.WeightKg.ToString("0.0") kg</dd></div><div><dt>IMC</dt><dd>@Model.CalculateBmi(Model.Client?.HeightCm ?? 0).ToString("0.00")</dd></div><div><dt>Cintura</dt><dd>@Model.WaistCm.ToString("0.0") cm</dd></div><div><dt>Pecho</dt><dd>@Model.ChestCm.ToString("0.0") cm</dd></div><div><dt>Brazo</dt><dd>@Model.ArmCm.ToString("0.0") cm</dd></div><div><dt>Pierna</dt><dd>@Model.LegCm.ToString("0.0") cm</dd></div><div><dt>Grasa corporal</dt><dd>@Model.BodyFatPercentage.ToString("0.0")%</dd></div></dl><div class="actions" style="margin-top:22px"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-secondary" asp-action="Index">Volver</a></div></div></section>